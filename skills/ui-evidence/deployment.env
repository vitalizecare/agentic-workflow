# ui-evidence settings for Vitalize's web-app (~/vitalize/web-app). See SKILL.md "Configuration":
# the environment and a local .ui-evidence.local.env override anything here. No secrets in this file.

# doctor: the <title> :3000/login shows, the local Postgres container, and the api-server port.
UI_EVIDENCE_APP_TITLE="Vitalize"
UI_EVIDENCE_DB_CONTAINER=postgres_container
UI_EVIDENCE_DB_USER=postgres
UI_EVIDENCE_API_PORT=5002

# --host previews: per-PR living previews only; dev/staging/prod under vitalize.build never match.
UI_EVIDENCE_PREVIEW_HOST_PATTERN=pr-[0-9]+\.vitalize\.build

# Seed provenance (gates uploading evidence to Linear): the local seed creates
# super-admin-<hsId>@vitalize.care in public.profile; any other domain means the DB may hold real data.
UI_EVIDENCE_SEED_TABLE=public.profile
UI_EVIDENCE_SEED_DOMAINS=vitalize.care
UI_EVIDENCE_SEED_EMAIL_PATTERN=super-admin-%@vitalize.care
